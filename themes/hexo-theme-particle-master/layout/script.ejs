<script>
    new Vue({
        el: "#layout",
        data: {
            show_page: false,
            onload_menu: false,
            menu_show: false,
            card_top: 100
        },
        created: function () {
            var that = this
            window.onload = function () {
                that.show_page = true
                document.getElementById("loadcontent").style.opacity = 0
                setTimeout(function () {
                    document.getElementById("loadleft").style.width = 0
                    document.getElementById("loadright").style.width = 0
                }, 300)
                setTimeout(function () {
                    document.getElementById("loading").style = "display:none"
                }, 600)
            }
        },
        mounted: function () {
            var that = this
            window.addEventListener('scroll', function (e) {
                that.menu_show = false
            })
        },
        methods: {
            home_click: function () {
                window.scrollTo({
                    top: window.innerHeight - 80,
                    behavior: "smooth",
                });
            }
        }
    })
</script>
<% if(theme.gitalk.enable && is_post()){ %>
<script src="https://cdn.jsdelivr.net/npm/gitalk@1/dist/gitalk.min.js"></script>
<script>
    const gitalk = new Gitalk({
        clientID: '<%- theme.gitalk.clientID %>',
        clientSecret: '<%- theme.gitalk.clientSecret %>',
        repo: '<%- theme.gitalk.repo %>',      // The repository of store comments,
        owner: '<%- theme.gitalk.owner %>',
        admin: ['<%- theme.gitalk.admin %>'],
        language: '<%- theme.gitalk.language %>',
        id: location.pathname,      // Ensure uniqueness and length less than 50
        distractionFreeMode: true  // Facebook-like distraction free mode
    })
    gitalk.render('gitalk-container')
</script>
<% } %>
<script>
(function () {
    var state = window.YZ_LANGUAGE || {};
    var supported = state.supported || ['en', 'zh-TW', 'zh-CN', 'my'];
    var labels = state.labels || { en: 'English', 'zh-TW': '繁體中文', 'zh-CN': '简体中文', my: 'Bahasa Melayu' };
    var translations = state.translations || {};

    function normalizeLang(lang) {
        return supported.indexOf(lang) !== -1 ? lang : 'en';
    }

    function currentLang() {
        return normalizeLang(localStorage.getItem('user-lang') || 'en');
    }

    function routeForLang(lang) {
        return (state.routeMap || {})[lang];
    }

    function normalizedPath(url) {
        var link = document.createElement('a');
        link.href = url;
        return link.pathname.replace(/\/+$/, '/') || '/';
    }

    function redirectToLangRoute(lang) {
        var target = routeForLang(lang);
        if (!target) return false;
        if (normalizedPath(target) === (window.location.pathname.replace(/\/+$/, '/') || '/')) return false;
        window.location.href = target + window.location.hash;
        return true;
    }

    function setUrlLang(lang) {
        var url = new URL(window.location.href);
        url.searchParams.set('lang', lang);
        window.history.replaceState({}, '', url.pathname + url.search + url.hash);
    }

    function setPaginationLang(lang) {
        document.querySelectorAll('.page-current a').forEach(function (link) {
            var url = new URL(link.getAttribute('href'), window.location.origin);
            url.searchParams.set('lang', lang);
            link.setAttribute('href', url.pathname + url.search + url.hash);
        });
    }

    function hasLang(node, lang) {
        return (node.getAttribute('data-post-langs') || '').split(/\s+/).indexOf(lang) !== -1;
    }

    function applyTranslations(lang) {
        var dictionary = translations[lang] || translations.en || {};
        document.querySelectorAll('[data-i18n]').forEach(function (node) {
            var key = node.getAttribute('data-i18n');
            if (!dictionary[key]) return;
            if (dictionary[key].indexOf('<') !== -1) {
                node.innerHTML = dictionary[key];
            } else {
                node.textContent = dictionary[key];
            }
        });
        document.querySelectorAll('[data-language-current]').forEach(function (node) {
            node.textContent = labels[lang] || lang;
        });
        document.querySelectorAll('[data-language-trigger]').forEach(function (node) {
            node.setAttribute('aria-label', labels[lang] || lang);
        });
    }

    function applyLangContent(root, lang, forceBlock) {
        root.querySelectorAll('[data-lang-content]').forEach(function (node) {
            node.style.display = node.getAttribute('data-lang-content') === lang ? (forceBlock || 'block') : 'none';
        });
    }

    function applyHome(lang) {
        var feed = document.querySelector('[data-feed-list]');
        if (!feed) return;

        var perPage = parseInt(feed.getAttribute('data-per-page'), 10) || 10;
        var pageNumber = parseInt(feed.getAttribute('data-page-number'), 10) || 1;
        var matchingPosts = Array.prototype.filter.call(feed.querySelectorAll('[data-feed-post]'), function (post) {
            return hasLang(post, lang);
        });
        var start = (pageNumber - 1) * perPage;
        var end = start + perPage;

        feed.querySelectorAll('[data-feed-post]').forEach(function (post) {
            var index = matchingPosts.indexOf(post);
            var showPost = index >= start && index < end;
            post.style.display = showPost ? '' : 'none';
            applyLangContent(post, lang, 'block');
        });
    }

    function applyVariantLists(lang) {
        document.querySelectorAll('[data-post-card]').forEach(function (entry) {
            var hasActiveTitle = hasLang(entry, lang);
            entry.style.display = hasActiveTitle ? '' : 'none';
            applyLangContent(entry, lang, 'block');
        });

        document.querySelectorAll('[data-title-variants]').forEach(function (group) {
            applyLangContent(group, lang, 'block');
        });
    }

    function updateUnsupportedWarning(lang) {
        var warning = document.querySelector('[data-post-unsupported-warning]');
        if (!warning) return;

        var routeMap = state.routeMap || {};
        var variantList = Object.keys(routeMap).filter(function (variantLang) {
            return Boolean(routeMap[variantLang]);
        });
        var supportedForPage = Boolean(routeMap[lang]);

        warning.style.display = supportedForPage || variantList.length === 0 ? 'none' : '';
        if (!warning.style.display || warning.style.display === 'none') return;

        var links = warning.querySelector('[data-post-variant-links]');
        if (!links) return;

        links.innerHTML = variantList.map(function (variantLang) {
            var href = routeMap[variantLang];
            return '<li><a href="' + href + '">' + (labels[variantLang] || variantLang) + '</a></li>';
        }).join('');
    }

    function applyLanguage(lang) {
        lang = normalizeLang(lang);
        localStorage.setItem('user-lang', lang);
        document.documentElement.setAttribute('lang', lang);
        applyTranslations(lang);
        applyHome(lang);
        applyVariantLists(lang);
        updateUnsupportedWarning(lang);
        setPaginationLang(lang);
    }

    function switchLanguage(lang) {
        lang = normalizeLang(lang);
        localStorage.setItem('user-lang', lang);
        if (redirectToLangRoute(lang)) return;
        setUrlLang(lang);
        applyLanguage(lang);
    }

    document.addEventListener('click', function (event) {
        var trigger = event.target.closest('[data-language-trigger]');
        if (trigger) {
            event.preventDefault();
            var menu = trigger.closest('[data-language-menu]');
            if (!menu) return;
            var isOpen = menu.classList.contains('is-open');
            document.querySelectorAll('[data-language-menu].is-open').forEach(function (item) {
                item.classList.remove('is-open');
            });
            if (!isOpen) {
                menu.classList.add('is-open');
            }
            document.querySelectorAll('[data-language-trigger]').forEach(function (button) {
                button.setAttribute('aria-expanded', String(menu.classList.contains('is-open')));
            });
            return;
        }

        var option = event.target.closest('[data-language-option]');
        if (option) {
            event.preventDefault();
            switchLanguage(option.getAttribute('value') || option.value);
            document.querySelectorAll('[data-language-menu].is-open').forEach(function (item) {
                item.classList.remove('is-open');
            });
            return;
        }

        if (!event.target.closest('[data-language-menu]')) {
            document.querySelectorAll('[data-language-menu].is-open').forEach(function (item) {
                item.classList.remove('is-open');
            });
        }
    });

    document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') {
            document.querySelectorAll('[data-language-menu].is-open').forEach(function (item) {
                item.classList.remove('is-open');
            });
        }
    });

    window.yuzhouApplyLanguage = applyLanguage;
    applyLanguage(currentLang());
    window.addEventListener('load', function () {
        applyLanguage(currentLang());
    });
})();
</script>