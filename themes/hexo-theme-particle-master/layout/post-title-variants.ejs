<% var titleVariants = post_title_variants(post); %>
<div class="post-title-variants" data-title-variants data-post-langs="<%- titleVariants.map(function(variant){ return variant.lang; }).join(' ') %>">
    <% titleVariants.forEach(function(variant){ %>
    <a class="post-title-variant" href="<%- variant.url %>" hreflang="<%- variant.lang %>" data-lang-content="<%- variant.lang %>">
        <h3><%- variant.title %></h3>
    </a>
    <% }) %>
</div>