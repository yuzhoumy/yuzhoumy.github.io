<% var titleVariants = post_title_variants(post); %>
<div class="post-title-variants">
    <% titleVariants.forEach(function(variant, index){ %>
    <a class="post-title-variant <%- index === 0 ? 'primary' : 'secondary' %>" href="<%- variant.url %>" hreflang="<%- variant.lang %>">
        <% if(index === 0){ %>
        <h3><%- variant.title %></h3>
        <% } else { %>
        <div class="alternate-title"><%- variant.title %></div>
        <% } %>
    </a>
    <% }) %>
</div>