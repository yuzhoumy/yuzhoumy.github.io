<%
var current = (page.current - 1) * config.index_generator.per_page;
var rootlink = config.root;
var homePosts = [];
site.posts.forEach(function(post){
    if (is_primary_post_variant(post)) homePosts.push(post);
});
%>
<div class="feed-language-switcher" data-feed-language-switcher>
    <button type="button" class="language-button active" data-lang="en">English</button>
    <button type="button" class="language-button" data-lang="zh-TW">繁體中文</button>
    <button type="button" class="language-button" data-lang="zh-CN">简体中文</button>
    <button type="button" class="language-button" data-lang="my">Bahasa Melayu</button>
</div>

<% homePosts.forEach(function(post){ %>
<% var variants = post_language_entries(post); %>
<div class="post" data-feed-post>

    <div class="feed-post-title">
        <% variants.forEach(function(variant){ %>
        <a href="<%- variant.url %>" data-lang-content="<%- variant.lang %>">
            <h2><%- variant.title %></h2>
        </a>
        <% }) %>
    </div>

    <div class="category-and-date">

        <% if(post.categories.data.length!=0){ %>
        <span class="category">
            <a href="<%- rootlink %>categories/<%= post.categories.data[0].name.replace(" ", "-") %>">
                <span class="icon">
                    <a-icon type="book" theme="filled" /></span>
                <%- post.categories.data[0].name %>
            </a>
        </span>
        <% } %>

        <span class="date">
            <span class="icon">
                <a-icon type="calendar" theme="filled" />
            </span>
            <%- date(post.date, 'YYYY/M/D', 'en') %>
        </span>

    </div>

    <div class="excerpt">
        <% variants.forEach(function(variant){ %>
        <div class="content" v-pre data-lang-content="<%- variant.lang %>">
            <% if(variant.excerpt && variant.excerpt.length != 0){ %>
            <%- variant.excerpt %>
            <% } %>
            <% if(!variant.excerpt || variant.excerpt.length == 0){ %>
            <%- variant.content %>
            <% } %>
        </div>
        <% }) %>
    </div>

    <div class="post-tags">
        <% if(post.tags.data.length!=0){ %>
        <span class="icon">
            <a-icon type="tags" theme="filled" />
        </span>
        <% } %>
        <% post.tags.data.forEach(function(data){%>
        <span class="tag">
            <%
            if(theme.style == "night"){
                var color = ['color:#607d8b', 'color:#6484be', 'color:#006674','color:#016a99']
            }else if(theme.style == "maiden"){
                var color = ['color:#ffa2c4', 'color:#00bcd4', 'color:#879cff', 'color:#1bccbc', 'color:#ff7d73'];
            }else{
                var color = ['color:#ffa2c4', 'color:#00bcd4', 'color:#03a9f4', 'color:#00a596', 'color:#ff7d73'];
            }
            var num = Math.floor(Math.random()*color.length);
            %>
            <a href="<%- rootlink %>tags/<%= data.name.replace(" ", "-") %>" style=<%- color[num] %>>
                <%- data.name %>
            </a>
        </span>
        <% }) %>
    </div>

    <% variants.forEach(function(variant){ %>
    <a href="<%- variant.url %>" class="go-post" data-lang-content="<%- variant.lang %>">
        Read More
    </a>
    <% }) %>
</div>
<% }); %>

<script>
(function () {
    var supported = ['en', 'zh-TW', 'zh-CN', 'my'];
    var params = new URLSearchParams(window.location.search);
    var currentLang = params.get('lang') || localStorage.getItem('feedLang') || 'en';
    if (supported.indexOf(currentLang) === -1) currentLang = 'en';

    var perPage = <%- config.index_generator.per_page %>;
    var pageNumber = <%- page.current %>;

    function supportsLang(post, lang) {
        return !!post.querySelector('[data-lang-content="' + lang + '"]');
    }

    function setPaginationLang(lang) {
        document.querySelectorAll('.page-current a').forEach(function (link) {
            var url = new URL(link.getAttribute('href'), window.location.origin);
            url.searchParams.set('lang', lang);
            link.setAttribute('href', url.pathname + url.search + url.hash);
        });
    }

    function setLang(lang) {
        currentLang = supported.indexOf(lang) === -1 ? 'en' : lang;
        localStorage.setItem('feedLang', currentLang);
        document.querySelectorAll('[data-feed-language-switcher] .language-button').forEach(function (button) {
            button.classList.toggle('active', button.getAttribute('data-lang') === currentLang);
        });
        var matchingPosts = Array.prototype.filter.call(document.querySelectorAll('[data-feed-post]'), function (post) {
            return supportsLang(post, currentLang);
        });
        var start = (pageNumber - 1) * perPage;
        var end = start + perPage;

        document.querySelectorAll('[data-feed-post]').forEach(function (post) {
            var index = matchingPosts.indexOf(post);
            var showPost = index >= start && index < end;
            post.classList.toggle('feed-post-visible', showPost);
            post.style.display = showPost ? '' : 'none';
            post.querySelectorAll('[data-lang-content]').forEach(function (node) {
                node.style.display = showPost && node.getAttribute('data-lang-content') === currentLang ? 'block' : 'none';
            });
        });
        setPaginationLang(currentLang);
    }

    document.addEventListener('click', function (event) {
        var button = event.target.closest('[data-feed-language-switcher] .language-button');
        if (!button) return;

        event.preventDefault();
        var lang = button.getAttribute('data-lang');
        var url = new URL(window.location.href);
        url.searchParams.set('lang', lang);
        window.history.replaceState({}, '', url.pathname + url.search + url.hash);
        setLang(lang);
    });

    setLang(currentLang);
    window.addEventListener('load', function () {
        setLang(currentLang);
    });
    setTimeout(function () {
        setLang(currentLang);
    }, 0);
})();
</script>