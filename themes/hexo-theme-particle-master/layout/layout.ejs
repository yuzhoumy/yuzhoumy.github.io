<% 
    var pageTitle = ' - Yuzhou 宇宙';
    if(page.title) pageTitle=page.title + pageTitle;
    else if(is_category()) pageTitle=page.category + pageTitle;
    else if(is_tag()) pageTitle=page.tag + pageTitle;
    else pageTitle=config.title;
    var layout = "index"
    if(is_home()){
        layout = "index"
    }else if(is_post()){
        layout = "single"
    }else if(page.layout){
        layout = page.layout
    }else if(is_page()){
        layout = "page"
    }else if(is_category() || page.title=="categories"){
        layout = "categories"
    }else if(is_tag() || page.title=="tags"){
        layout = "tags"
    }else if(is_archive() || is_year() || is_month()){
        layout = "archives"
    }else {
        layout = "post"
    }
    var rootlink = config.root
    site.posts.data.sort(function(a, b){
        return b.date - a.date;
    })
%>
<!DOCTYPE html>
<html lang="<%- config.language %> ">
<head>
    
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %></title>
    <meta name="author" content="<%- config.author %>">
    <meta name="description" content="<%- config.description %> ">
    <meta name="keywords" content="<%- config.keywords %> ">
    <script>
    window.YZ_LANGUAGE = {
        supported: ['en', 'zh-TW', 'zh-CN', 'my'],
        labels: {
            en: 'English',
            'zh-TW': '\u7e41\u9ad4\u4e2d\u6587',
            'zh-CN': '\u7b80\u4f53\u4e2d\u6587',
            my: 'Bahasa Melayu'
        },
        routeMap: <%- JSON.stringify(language_route_map(page)) %>,
        translations: {
            en: {
                'nav.home': 'Home',
                'nav.about': 'About',
                'nav.archives': 'Archives',
                'nav.friends': 'Friends',
                'nav.categories': 'Categories',
                'nav.tags': 'Tags',
                'home.subtitle': '<%- config.subtitle %>',
                'home.description': '<%- config.description %>',
                'card.description1': '<%- (theme.card.description && theme.card.description[0]) || "" %>',
                'card.description2': '<%- (theme.card.description && theme.card.description[1]) || "" %>',
                'friends.kicker': 'Friends',
                'friends.pageTitle': '<%- page.title || "Friends" %>',
                'friends.pageDescription': '<%- page.description || "" %>',
                'friends.empty': 'Add entries to the <code>friends</code> list in this page\'s front matter to show profile cards here.',
                'footer.basedOn': 'Based on the',
                'footer.icp': '备案号',
                'card.friendLink': 'About me',
                'ui.readMore': 'Read More',
                'ui.loading': 'LOADING...',
                'ui.cacheHint': 'Please enable caching if loading is too slow (enabled by default in browsers).',
                'post.unsupportedTitle': 'This version is not available in your selected language.',
                'post.unsupportedDescription': 'Try one of the available variants below.'
            },
            'zh-TW': {
                'nav.home': '\u9996\u9801',
                'nav.about': '\u95dc\u65bc',
                'nav.archives': '\u6b78\u6a94',
                'nav.friends': '\u53cb\u93c8',
                'nav.categories': '\u5206\u985e',
                'nav.tags': '\u6a19\u7c64',
                'home.subtitle': '歡迎來到我的小宇宙~',
                'home.description': '我從12歲開始稱自己為「宇宙」',
                'card.description1': '一位馬來西亞高中生，目前 17 歲。',
                'card.description2': '我會把日常想法和生活點滴分享在這裡。',
                'friends.kicker': '朋友們',
                'friends.pageTitle': '友站',
                'friends.pageDescription': '如果想要互加友站可以發email給我。:)',
                'friends.empty': '在這個頁面的 front matter 中新增 <code>friends</code> 條目，就能在這裡顯示好友卡片。',
                'footer.basedOn': '基於',
                'footer.icp': '備案號',
                'card.friendLink': '關於',
                'ui.readMore': '\u95b1\u8b80\u66f4\u591a',
                'ui.loading': '\u8f09\u5165\u4e2d...',
                'ui.cacheHint': '\u5982\u679c\u8f09\u5165\u592a\u6162\uff0c\u8acb\u555f\u7528\u700f\u89bd\u5668\u5feb\u53d6\u3002'
            },
            'zh-CN': {
                'nav.home': '\u9996\u9875',
                'nav.about': '\u5173\u4e8e',
                'nav.archives': '\u5f52\u6863',
                'nav.friends': '\u53cb\u94fe',
                'nav.categories': '\u5206\u7c7b',
                'nav.tags': '\u6807\u7b7e',
                'home.subtitle': '欢迎来到我的小宇宙~',
                'home.description': '我从12岁开始称自己为「宇宙」',
                'card.description1': '一位马来西亚高中生，目前 17 岁。',
                'card.description2': '我会把日常想法和生活点滴分享在这里。',
                'friends.kicker': '朋友们',
                'friends.pageTitle': '友站',
                'friends.pageDescription': '如果想要互加友站可以发email给我。:)',
                'friends.empty': '在这个页面的 front matter 中新增 <code>friends</code> 条目，就能在这里显示好友卡片。',
                'footer.basedOn': '基于',
                'footer.icp': '备案号',
                'card.friendLink': '关于',
                'ui.readMore': '\u9605\u8bfb\u66f4\u591a',
                'ui.loading': '\u52a0\u8f7d\u4e2d...',
                'ui.cacheHint': '\u5982\u679c\u52a0\u8f7d\u592a\u6162\uff0c\u8bf7\u542f\u7528\u6d4f\u89c8\u5668\u7f13\u5b58\u3002'
            },
            my: {
                'nav.home': 'Laman Utama',
                'nav.about': 'Tentang',
                'nav.archives': 'Arkib',
                'nav.friends': 'Rakan',
                'nav.categories': 'Kategori',
                'nav.tags': 'Tag',
                'home.subtitle': 'Selamat datang ke ruang saya',
                'home.description': 'Kongsi kehidupan, pemikiran, dan catatan harian saya.',
                'card.description1': 'Seorang pelajar sekolah menengah Malaysia, berusia 17 tahun.',
                'card.description2': 'Saya akan berkongsi kehidupan harian dan pemikiran saya di sini.',
                'friends.kicker': 'Rakan',
                'friends.pageTitle': 'Profil Rakan',
                'friends.pageDescription': 'Kalau nak tambah rakan, sila hantar e-mel kepada saya. :)',
                'friends.empty': 'Tambah entri <code>friends</code> dalam front matter halaman ini untuk memaparkan kad profil di sini.',
                'footer.basedOn': 'Berasaskan',
                'footer.icp': 'No. Pendaftaran',
                'card.friendLink': 'Lebih tentang saya',
                'ui.readMore': 'Baca Lagi',
                'ui.loading': 'MEMUATKAN...',
                'ui.cacheHint': 'Sila aktifkan cache jika laman dimuatkan terlalu perlahan.',
                'post.unsupportedTitle': 'Versi ini tidak tersedia dalam bahasa pilihan anda.',
                'post.unsupportedDescription': 'Sila pilih versi yang tersedia di bawah.'
            }
        }
    };

    (function () {
        var state = window.YZ_LANGUAGE;
        var supported = state.supported;
        var params = new URLSearchParams(window.location.search);
        var queryLang = params.get('lang');
        var routeMap = state.routeMap || {};
        var path = window.location.pathname.replace(/\/+$/, '/') || '/';
        var pathLangMatch = path.match(/\/(en|zh-TW|zh-CN|my)\/?$/);
        var pathLang = pathLangMatch ? pathLangMatch[1] : null;
        var lang = supported.indexOf(queryLang) !== -1 ? queryLang : (pathLang || localStorage.getItem('user-lang') || 'en');
        if (supported.indexOf(lang) === -1) lang = 'en';
        if (supported.indexOf(queryLang) !== -1) localStorage.setItem('user-lang', lang);
        else if (pathLang) localStorage.setItem('user-lang', lang);
        else if (!localStorage.getItem('user-lang')) localStorage.setItem('user-lang', lang);
        document.documentElement.setAttribute('lang', lang);

        var target = routeMap[lang];
        var hasLangSuffix = Boolean(pathLang);
        var shouldRedirect = target && (supported.indexOf(queryLang) !== -1 || !hasLangSuffix);
        if (shouldRedirect) {
            var link = document.createElement('a');
            link.href = target;
            var targetPath = link.pathname.replace(/\/+$/, '/') || '/';
            if (targetPath !== path) {
                window.location.replace(target + window.location.hash);
            }
        }
    })();
    </script>
    <link rel="icon" href="<%- rootlink %><%- theme.head_img %>">
    <link rel="stylesheet" href="<%- rootlink %>css/antd.min.css">
    <% if(theme.style == "night"){ %>
    <link rel="stylesheet" href="<%- rootlink %>css/night-theme.css">
    <% }else if(theme.style == "maiden"){ %>
    <link rel="stylesheet" href="<%- rootlink %>css/maiden-theme.css">
    <% }else{ %>
    <link rel="stylesheet" href="<%- rootlink %>css/full-theme.css">
    <% } %>
    <% if(theme.gitalk && theme.gitalk.enable && is_post()){ %>
    <link rel="stylesheet" href="<%- rootlink %>css/gitalk.min.css">
    <% } %>
    <script src="<%- rootlink %>js/vue.js"></script>
    <script src="<%- rootlink %>js/antd.min.js"></script>
</head>

<body>

    <div id="loading"
        style="height: 100vh; width: 100%; position: fixed;display: flex;z-index: 200; justify-content: space-between;">
        <div id="loadleft" style="width: 50%;background-color: #ffffff;transition: width 0.6s ease-out;"></div>
        <div id="loadright" style="width: 50%;background-color: #ffffff;transition: width 0.6s ease-out;"></div>
        <div
            style="position: fixed; height: 100vh; width: 100%;display: flex;justify-content: center;align-items: center;">
            <div id="loadcontent"
                style="width:400px;height:400px;padding:50px;border-radius:50%;display:flex;justify-content:center;align-items:center;border:solid 10px#a3ddfb; text-align:center;opacity:1;transition:opacity 0.3s ease-out;">
                <div>
                    <h2 data-i18n="ui.loading">LOADING...</h2>
                    <p data-i18n="ui.cacheHint">Please enable caching if loading is too slow (enabled by default in browsers).</p>
                    <div>
                        <img src="<%- rootlink %>images/loading.gif" alt="loading">
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="layout">
        <transition name="into">
            <div v-show="show_page" style="display: none;">
                <div id="menu_show">
                    <%- include("menu") %>
                </div>

                <div id="main">
                    <%- include(layout) %>
                    <%- include("footer") %>
                </div>
            </div>
        </transition>
    </div>

    <%- include("script") %>
</body>

</html>
