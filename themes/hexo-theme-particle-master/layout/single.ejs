<%
var rootlink = config.root;
%>
<div id="home-posts-wrap">
    <div id="home-posts">
<div class="post">

    <h2>
        <%- page.title %>
    </h2>

    <div class="category-and-date">

        <% if(page.categories && page.categories.data.length!=0){ %>
        <span class="category">
            <a href="<%- rootlink %>categories/<%= page.categories.data[0].name.replace(" ", "-") %>">
                <span class="icon">
                    <a-icon type="book" theme="filled" /></span>
                <%- page.categories.data[0].name %>
            </a>
        </span>
        <% } %>

        <span class="date">
            <span class="icon">
                <a-icon type="calendar" theme="filled" />
            </span>
            <%- date(page.date, 'YYYY/M/D') %>
        </span>

    </div>

    <div class="content" v-pre>
        <%- page.content %>
    </div>

    <% var postVariants = post_language_entries(page); %>
    <% if(postVariants.length > 1){ %>
    <div class="post-language-warning" data-post-unsupported-warning style="display:none">
        <div class="warning-title" data-i18n="post.unsupportedTitle">This version is not available in your selected language.</div>
        <p class="warning-description" data-i18n="post.unsupportedDescription">Try one of the available variants below.</p>
        <ul class="warning-links" data-post-variant-links></ul>
    </div>
    <% } %>

    <div class="post-tags">
        <% if(page.tags && page.tags.data.length!=0){ %>
        <span class="icon">
            <a-icon type="tags" theme="filled" />
        </span>
        <% } %>
        <% page.tags.data.forEach(function(data){%>
        <span class="tag">
            <% 
            if(theme.style == "night"){
                var color = ['color:#607d8b', 'color:#6484be', 'color:#006674','color:#016a99']
            }else if(theme.style == "maiden"){
                var color = ['color:#ffa2c4', 'color:#00bcd4', 'color:#879cff', 'color:#1bccbc', 'color:#ff7d73'];
            }else{
                var color = ['color:#ffa2c4', 'color:#00bcd4', 'color:#03a9f4', 'color:#00a596', 'color:#ff7d73'];
            }
            var num = Math.floor(Math.random()*color.length);
            %>
            <a href="<%- rootlink %>tags/<%= data.name.replace(" ", "-") %>" style=<%- color[num] %>>
                <%- data.name %>
            </a>
        </span>
        <% }) %>
    </div>

    <div class="post-comments">
        <div id="gitalk-container"></div>
    </div>

</div>
    </div>
</div>