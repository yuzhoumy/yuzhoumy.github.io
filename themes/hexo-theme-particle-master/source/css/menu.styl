#menu
    user-select none
    z-index 105
    position fixed
    width 100%
    line-height 50px
    font-weight bold
    transition top 0.5s ease-out
    background menu-default-background
    box-shadow 0px -1px 10px 0px #9e9e9e4d
    top 0

    .desktop-menu
        height 50px

        .title
            display inline-block
            margin-left 30px
            margin-right 20px
            font-family default-font-family
            text-transform uppercase
            color menu-default-font

        a
            display inline-block
            margin-left 30px
            text-decoration none
            color menu-default-font

            span
                display inline-block
                position relative

                img
                    position relative
                    top 3px
                    width 20px
                    height 20px

                &:nth-child(1)
                    margin-right 5px

        .global-language-menu
            float right
            position relative
            margin-right 24px
            height 50px
            display flex
            align-items center

            .global-language-trigger
                display inline-flex
                align-items center
                gap 8px
                height 36px
                padding 0 12px
                border 0
                border-radius 999px
                background rgba(255, 255, 255, 0.2)
                color menu-default-font
                font-weight bold
                cursor pointer
                font-family inherit
                outline none
                transition all 0.25s ease
                appearance none
                -webkit-appearance none

                &:hover, &.is-open
                    background rgba(255, 255, 255, 0.3)

            .global-language-caret
                display inline-block
                width 8px
                height 8px
                border-right 2px solid currentColor
                border-bottom 2px solid currentColor
                transform rotate(45deg)
                margin-top -2px
                transition transform 0.25s ease

            .global-language-dropdown
                position absolute
                top calc(100% + 8px)
                right 0
                min-width 160px
                background menu-default-background
                border 1px solid rgba(0, 0, 0, 0.08)
                border-radius 10px
                box-shadow 0 12px 30px rgba(0, 0, 0, 0.15)
                overflow hidden
                display none
                z-index 5

                .global-language-option
                    width 100%
                    display block
                    padding 10px 12px
                    border 0
                    background transparent
                    text-align left
                    color menu-default-font
                    font-family inherit
                    font-weight 600
                    cursor pointer
                    appearance none
                    -webkit-appearance none

                    &:hover
                        background rgba(0, 0, 0, 0.06)

            &.is-open
                .global-language-dropdown
                    display block

                .global-language-caret
                    transform rotate(-135deg)
                    margin-top 2px

    .phone-menu
        min-height 50px
        text-align center
        transition all 0.3s ease-out

        .title
            cursor pointer
            color menu-default-font

        .items
            padding 10px 0 20px
            z-index 104
            transition all 0.3s ease-out

            a
                color menu-default-font

            .item
                min-width 200px
                width 80%
                margin auto
                display flex
                justify-content center

                &:hover
                    background #ffffff80

            .mobile-language-options
                display flex
                flex-direction column
                align-items center
                margin-top 12px

                .global-language-trigger
                    width min(220px, 80%)
                    justify-content center
                    border 1px solid rgba(255, 255, 255, 0.35)
                    border-radius 999px
                    background transparent
                    color menu-default-font
                    padding 8px 12px
                    font-weight bold
                    font-family inherit

                .global-language-dropdown
                    width min(220px, 80%)
                    margin-top 6px
                    border-radius 10px
                    background rgba(255, 255, 255, 0.95)
                    box-shadow 0 8px 20px rgba(0, 0, 0, 0.12)
                    display none
                    flex-direction column

                    .global-language-option
                        color #233
                        padding 10px 12px

                &.is-open
                    .global-language-dropdown
                        display flex

        .curtain
            position fixed
            z-index 104
            width 100%
            height 100%
            background #0009

.hidden-menu
    top -70px !important

.menu-color
    background menu-index-background !important
    box-shadow 0px -1px 10px 0px #ffffff00 !important

    .false
        background #00000033

    .true
        background #0009 !important

    .title, a
        color menu-index-font !important

    .global-language-menu .global-language-trigger,
    .mobile-language-options .global-language-trigger
        color #fff !important
        background transparent !important
        border-color rgba(255, 255, 255, 0.32) !important

    .global-language-menu .global-language-dropdown,
    .mobile-language-options .global-language-dropdown
        background rgba(0, 0, 0, 0.18) !important
        border 1px solid rgba(255, 255, 255, 0.24) !important
        box-shadow 0 12px 30px rgba(0, 0, 0, 0.18) !important
        backdrop-filter blur(10px)

    .global-language-menu .global-language-option,
    .mobile-language-options .global-language-option
        color #fff !important
        background transparent !important

    .global-language-menu .global-language-option:hover,
    .mobile-language-options .global-language-option:hover
        color #fff !important
        background rgba(255, 255, 255, 0.16) !important