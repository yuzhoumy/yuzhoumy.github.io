
.article
    margin auto
    position relative
    top 100px
    color text-font
    padding 20px
    font-size 15px

    h1
        font-weight bolder
        margin 20px 0

    .info
        a
            color #5c6b72
            text-decoration none

        .date, .category, .tags
            color #5c6b72
            display inline-block
            margin-right 20px

            .tag
                margin-right 10px

    .content
        margin 50px 0

    .post-language-warning
        margin 24px 0 32px
        padding 16px 18px
        border-left 4px solid #f0b429
        border-radius 10px
        background rgba(240, 180, 41, 0.14)
        color text-font

        .warning-title
            font-weight bold
            margin-bottom 4px

        .warning-description
            margin 0 0 8px
            color #7a5a00

        .warning-links
            margin 0
            padding-left 18px

            li
                margin 4px 0

            a
                color #8c5b00
                font-weight 600
